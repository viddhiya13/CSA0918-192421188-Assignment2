import java.util.HashSet;
import java.util.Objects;
import java.util.Set;

class Student {
    private final int registerNumber;
    private final String name;

    Student(int registerNumber, String name) {
        this.registerNumber = registerNumber;
        this.name = name;
    }

    @Override
    public boolean equals(Object obj) {
        if (this == obj) return true;
        if (!(obj instanceof Student)) return false;
        Student other = (Student) obj;
        return registerNumber == other.registerNumber;
    }

    @Override
    public int hashCode() {
        return Objects.hash(registerNumber);
    }

    @Override
    public String toString() {
        return registerNumber + " - " + name;
    }
}

public class Attendance {
    public static void main(String[] args) {
        Set<Student> attendance = new HashSet<>();
        attendance.add(new Student(101, "Arun"));
        attendance.add(new Student(101, "Arun Kumar"));
        attendance.add(new Student(102, "Priya"));

        System.out.println("Attendance records:");
        for (Student student : attendance) {
            System.out.println(student);
        }
        System.out.println("Total unique students: " + attendance.size());
    }
}
